# Database (set one PostgreSQL/Neon connection string)
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Required for admin routes and the temporary dashboard protection.
ADMIN_ACCESS_CODE=replace-with-a-long-random-secret

# Public form abuse protection. Use a unique high-entropy secret in every environment.
PUBLIC_FORM_RATE_LIMIT_SECRET=replace-with-a-long-random-secret

# Authorizes scheduler endpoints. Vercel Cron and the GitHub scheduler send this value as
# Authorization: Bearer <CRON_SECRET> when configured for the deployed environment.
CRON_SECRET=replace-with-a-long-random-secret

# Company Profile Engine. Keep sync and auto-publish disabled until a real-data
# pilot has been checked field-by-field. The supported production strategy is
# based only on official, reusable and no-extra-cost company data.
COMPANY_DIRECTORY_PROVIDER=bolagsverket_vardefulla_datamangder
COMPANY_DIRECTORY_SYNC_ENABLED=false
COMPANY_DIRECTORY_AUTO_PUBLISH=false

# Discovery mode:
# - seed: safest first pilot. Källtest verifies only the explicit organisation
#   numbers below against the official detail API and writes nothing.
# - feed: compatibility mode for a verified JSON feed with cursor pagination.
# - automatic: production target. A scheduled worker reads Bolagsverket's official
#   downloadable HVD file, queues only pilot-area/service-SNI organisations, and
#   the backend verifies/builds profiles from that durable queue.
COMPANY_DIRECTORY_DISCOVERY_MODE=seed
COMPANY_DIRECTORY_SEED_ORGANIZATION_NUMBERS=
COMPANY_DIRECTORY_SOURCE_URL=
COMPANY_DIRECTORY_SOURCE_BEARER_TOKEN=
COMPANY_DIRECTORY_BATCH_SIZE=10
COMPANY_DIRECTORY_MAX_PAGES_PER_RUN=2
COMPANY_DIRECTORY_QUEUE_BATCH_SIZE=15

# Optional explicit official Bolagsverket bulk ZIP URL for the GitHub discovery
# worker. Leave empty to resolve the current distribution through data.europa.eu
# metadata. Only bolagsverket.se HTTPS download URLs are accepted by the worker.
BOLAGSVERKET_BULK_URL=

# Second-stage verification against the free Värdefulla datamängder API.
# Copy the current test/production URL, method and body schema from the official
# Bolagsverket developer portal after credentials are issued. Do not guess an
# operation path or request body.
COMPANY_DIRECTORY_DETAIL_URL_TEMPLATE=
COMPANY_DIRECTORY_DETAIL_METHOD=POST
COMPANY_DIRECTORY_DETAIL_BODY_TEMPLATE=

# Bolagsverket OAuth credentials for the free Värdefulla datamängder API.
# Obtain separate test and production values via the free access request; never
# commit real credentials. Keep URLs configurable so test and production cannot
# accidentally be mixed.
COMPANY_DIRECTORY_TOKEN_URL=
COMPANY_DIRECTORY_OAUTH_SCOPE=vardefulla-datamangder:read
BOLAGSVERKET_CLIENT_ID=
BOLAGSVERKET_CLIENT_SECRET=

# Email/SMS notifications through Brevo. Omit these only in local development when
# notifications are intentionally disabled.
BREVO_API_KEY=
LEAD_FROM_EMAIL=Proffera <no-reply@example.com>
BREVO_SMS_SENDER=

# Optional Service AI Chat webhook integration. Keep its tenant isolated to Proffera.
CHAT_LEAD_WEBHOOK_SECRET=

# Stripe subscription billing. Use test keys/prices in Preview and Sandbox.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_PRICE_STARTER=price_replace_me
STRIPE_PRICE_PROFESSIONAL=price_replace_me
# Turn on only after Adaptive Pricing is enabled and verified in the Stripe
# account. It lets hosted Checkout show a supported local currency while the
# configured subscription Price remains the source of truth.
STRIPE_ADAPTIVE_PRICING_ENABLED=false
# Keep false until the relevant Stripe Tax registrations have been configured
# and verified. Tax IDs are collected at Checkout regardless.
STRIPE_TAX_ENABLED=false

# Private bridge to the separate Service AI Chat project. Use the same
# high-entropy secret there as PROFFERA_AI_CHAT_INTEGRATION_SECRET.
SERVICE_AI_CHAT_BRIDGE_URL=https://chat.proffera.se/api/integrations/proffera
SERVICE_AI_CHAT_INTEGRATION_SECRET=replace-with-a-long-random-secret
SERVICE_AI_CHAT_ORIGIN=https://chat.proffera.se
